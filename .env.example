# Copier en .env (ignoré par Git). Production : variables Railway.
DATABASE_URL=postgres://localhost:5432/aquarium_dev
APP_PASSWORD=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vous@example.com
# Assistant (chat Claude) : clé de la console Anthropic. Facultatifs : modèle (claude-sonnet-5-5 par défaut) et limite de messages par jour (150).
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-sonnet-5-5
# ASSISTANT_DAILY_LIMIT=150
# Production Railway uniquement :
# HOST=0.0.0.0
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
